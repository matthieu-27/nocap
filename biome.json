{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      "*.mjs",
      "biome.json"
    ]
  },
  "plugins": [
    "./tools/biome-plugins/no-swallowed-errors.grit",
    "./tools/biome-plugins/no-interpolated-console.grit",
    "./tools/biome-plugins/no-setter-only-effect.grit",
    "./tools/biome-plugins/no-render-helpers.grit",
    "./tools/biome-plugins/descriptive-test-names.grit",
    "./tools/biome-plugins/require-assertion-reason.grit"
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
