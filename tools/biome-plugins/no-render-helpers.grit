engine biome(1.0)
language js

or {
    `function $NAME($$$PARAMS) { return <$TAG $$$ATTRS>$$$CHILDREN</$TAG>; }`,
    `function $NAME($$$PARAMS) { return <$TAG2 $$$ATTRS2 />; }`,
    `const $NAME = ($$$PARAMS2) => <$TAG3 $$$ATTRS3>$$$CHILDREN3</$TAG3>`,
    `const $NAME = ($$$PARAMS3) => <>$$$FRAGMENTS</>`
} where {
    $NAME <: regex("^[a-z].*"),
    register_diagnostic(
        span = $NAME,
        message = "returns JSX but is not a component — capitalize the name and use it as one (no-render-helpers)"
    )
}
