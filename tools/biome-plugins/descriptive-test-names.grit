engine biome(1.0)
language js

or { `it($NAME, $$$REST)`, `test($NAME, $$$REST)` } where {
    $NAME <: or {
        regex("^\"\\w+(\\s+\\w+){0,1}\\.*\"$"),
        regex("^\"[a-z]+(_[a-z]+)+\"$")
    },
    register_diagnostic(
        span = $NAME,
        message = "test name reads like code — describe behavior in plain words: subject + action + expected (descriptive-test-names)"
    )
}
